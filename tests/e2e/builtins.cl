int main() {
    print(max(7, 3));
    print(min(7, 3));
    print(abs(0 - 42));
    int a = 1; int b = 2;
    swap(a, b);
    print(a);
    print(b);
    int arr[5];
    arr[0] = 5; arr[1] = 4; arr[2] = 3; arr[3] = 2; arr[4] = 1;
    reverse(arr, 5);
    print(arr[0]);
    print(arr[4]);
    print(len(arr));
    return 0;
}
